{
  "name": "dsh-plugin-manager",
  "version": "0.1.0",
  "description": "DSH web plugin: enable/disable installed plugins from the browser, and audit every plugin download with its source and time.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}
